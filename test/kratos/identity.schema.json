{
  "$id": "https://example.org/kratos/identity.default.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sneakers Identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true } },
            "recovery": { "via": "email" }
          }
        },
        "first_name": { "type": "string", "title": "First Name" },
        "last_name": { "type": "string", "title": "Last Name" }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
