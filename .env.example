# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# The local Postgres from the README; see docs/configuration.md for the rest.
DATABASE_DSN=postgres://identity@localhost:5432/identity?sslmode=disable
GRPC_PORT=9090
# mTLS stays off locally. To turn it on set all three, plus HEALTH_PORT (plain, health only):
# MTLS_CERT_FILE=/tls/tls.crt
# MTLS_KEY_FILE=/tls/tls.key
# MTLS_CA_FILE=/tls/ca.crt
# HEALTH_PORT=9091
# Local development only: trust every caller without a workload token.
WORKLOAD_AUTH=disabled
OTP_DEV_ECHO=1

# The audit service; unset records no identity events.
# AUDIT_ADDR=localhost:9194
